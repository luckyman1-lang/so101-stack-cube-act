+                )
+                raw_offset, _, _ = self._read(
+                    off_addr, off_len, self.motors[motor].id, raise_on_error=True
+                )
+                v12 = raw_offset & 0x0FFF
+                offsets[motor] = v12 - 0x1000 if v12 > 0x7FF else v12
+            else:
+                offsets[motor] = 0
 

diff --git a/src/lerobot/cameras/opencv/camera_opencv.py b/src/lerobot/cameras/opencv/camera_opencv.py
index 1d7a164..707adbb 100644
--- a/src/lerobot/cameras/opencv/camera_opencv.py
+++ b/src/lerobot/cameras/opencv/camera_opencv.py
@@ -217,6 +217,41 @@ class OpenCVCamera(Camera):
         else:
             self._validate_width_and_height()
 
+            # [本地改动] 可选：固定白平衡 / 曝光，避免自动 AWB 在两次开相机
+            # 之间漂移导致画面偏色（训练和推理色温不一致会让策略判断错乱）。
+            #   LEROBOT_CAM_AWB=off      -> 关闭自动白平衡
+            #   LEROBOT_CAM_AWB_TEMP=5800 -> 指定色温（需同时关 AWB）
+            #   LEROBOT_CAM_AE=off        -> 关闭自动曝光
+            try:
+                import os as _os
+
+                _awb = _os.environ.get('LEROBOT_CAM_AWB', '').lower()
+                if _awb in ('off', '0', 'false'):
+                    _ok = self.videocapture.set(cv2.CAP_PROP_AUTO_WB, 0)
+                    _temp = _os.environ.get('LEROBOT_CAM_AWB_TEMP', '')
+                    if _temp:
+                        try:
+                            self.videocapture.set(cv2.CAP_PROP_WB_TEMPERATURE, float(_temp))
+                        except Exception:
+                            pass
+                    # 关键：色温设完必须读掉若干帧，相机内部才会真正切过去。
+                    # 实测不预热时红块仍是偏蓝的 H≈95，预热后回到 H≈24。
+                    _warm = int(_os.environ.get('LEROBOT_CAM_AWB_WARMUP', '30'))
+                    for _i in range(max(_warm, 0)):
+                        self.videocapture.read()
+                    _back = self.videocapture.get(cv2.CAP_PROP_WB_TEMPERATURE)
+                    logging.info(
+                        f'{self} 已关闭自动白平衡 (set ok={_ok}, temp={_temp or "默认"}, 回读={_back:.0f}, 预热={_warm}帧)'
+                    )
+                _ae = _os.environ.get('LEROBOT_CAM_AE', '').lower()
+                if _ae in ('off', '0', 'false'):
+                    self.videocapture.set(cv2.CAP_PROP_AUTO_EXPOSURE, 0.25)
+                    for _i in range(10):
+                        self.videocapture.read()
+                    logging.info(f'{self} 已关闭自动曝光')
+            except Exception as _exc:
+                logging.warning(f'{self} 设置白平衡/曝光失败: {_exc}')
+
     def _validate_fps(self) -> None:
         """Validates and sets the camera's frames per second (FPS)."""
 
